# HIUSA React/Vite frontend
# Copy this file to client/.env.
#
# Keep localhost here for normal development. When the page is opened from
# another PC through a LAN IP, HIUSA automatically replaces localhost with the
# browser's current hostname while retaining backend port 8000.

VITE_APP_NAME=HIUSA
VITE_API_URL=http://localhost:8000/api
# Avoid duplicate JSON GETs while navigating between recently viewed tables.
# Local mutations clear this in-memory cache immediately.
VITE_API_CACHE_TTL_MS=60000

# =============================================================================
# PRODUCTION OVERRIDE
# The EC2/Docker Compose stack this repo actually ships (see
# EC2-DEPLOYMENT.md) builds with VITE_API_URL=/api - compose.production.yml
# passes it as a build arg and client/Dockerfile.production defaults to it -
# because Caddy proxies /api to Laravel on the same domain the frontend is
# served from. That's same-origin: no CORS to configure, no separate API
# hostname to manage, and nothing in this file needs to change for that path.
#
# Only override this to an absolute, cross-domain URL, e.g.
# https://api.your-real-domain.example/api, if you deploy the API on a
# different domain than the frontend - a split-domain setup this repo does
# not ship. In that case: never localhost and never plain http:// once the
# frontend itself is served over HTTPS, or the browser will block the request
# as mixed content. This value is baked into the built bundle at `npm run
# build` time (Vite env vars are compile-time, not runtime), so it must be
# set correctly BEFORE building for production, and changing it means
# rebuilding, not just restarting a server.
# =============================================================================
