# HIUSA React/Vite frontend
# Copy this file to client/.env.
#
# Keep localhost here for normal development. When the page is opened from
# another PC through a LAN IP, HIUSA automatically replaces localhost with the
# browser's current hostname while retaining backend port 8000.

VITE_APP_NAME=HIUSA
VITE_API_URL=http://localhost:8000/api

# =============================================================================
# PRODUCTION OVERRIDE
# VITE_API_URL must become the real, public HTTPS URL of the deployed Laravel
# API, e.g. https://api.your-real-domain.example/api - never localhost and
# never plain http:// once the frontend itself is served over HTTPS, or the
# browser will block the request as mixed content. This value is baked into
# the built bundle at `npm run build` time (Vite env vars are compile-time,
# not runtime), so it must be set correctly BEFORE building for production,
# and changing it means rebuilding, not just restarting a server.
# =============================================================================
