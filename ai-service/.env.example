# HIUSA deterministic Python AI service
# Copy this file to ai-service/.env.
#
# This key must exactly match HIUSA_AI_SERVICE_KEY in server/.env.
# Generate a long random value; do not use this placeholder in production.
HIUSA_AI_SERVICE_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_KEY_IN_BOTH_FILES

# 0.0.0.0 permits health/docs access from other PCs on a trusted private LAN.
# Use 127.0.0.1 if the Python API should only be reachable by Laravel locally.
HIUSA_AI_HOST=0.0.0.0
HIUSA_AI_PORT=8001

# Keep true for local development. Set false on a deployed/production PC.
HIUSA_AI_RELOAD=true

# GROQ_API_KEY does not belong here. Laravel calls Groq; this service only runs
# deterministic OLS, budget-advisory rules, and weighted task delegation.
