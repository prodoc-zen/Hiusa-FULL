# HIUSA deterministic Python AI service
# Copy this file to ai-service/.env.
#
# This key must exactly match HIUSA_AI_SERVICE_KEY in server/.env.
# Generate a long random value; do not use this placeholder in production.
HIUSA_AI_SERVICE_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_KEY_IN_BOTH_FILES
HIUSA_TASK_POSITION_WEIGHT=0.40
HIUSA_TASK_WORKLOAD_WEIGHT=0.35
HIUSA_TASK_PERFORMANCE_WEIGHT=0.25

# 0.0.0.0 permits health/docs access from other PCs on a trusted private LAN.
# Use 127.0.0.1 if the Python API should only be reachable by Laravel locally.
HIUSA_AI_HOST=0.0.0.0
HIUSA_AI_PORT=8001

# Keep true for local development. Set false on a deployed/production PC.
HIUSA_AI_RELOAD=true

# GROQ_API_KEY does not belong here. Laravel calls Groq; this service only runs
# deterministic OLS, budget-advisory rules, and weighted task delegation.

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# HIUSA_AI_SERVICE_KEY - do not leave this empty in production.
# The service's own /health endpoint reports the risk directly: it returns
# "authentication": "disabled" when this key is blank, meaning the service
# FAILS OPEN - every endpoint accepts requests with no credential check at
# all. An empty key is acceptable only on a machine where 127.0.0.1 access is
# already fully trusted (e.g. solo local development). Any deployment reachable
# by more than the operator must set a real long random value here and the
# identical value in server/.env's HIUSA_AI_SERVICE_KEY.

# HIUSA_AI_HOST=0.0.0.0 in this template is a LAN-trust default: it lets other
# PCs on the same private network reach /health and /docs directly. In a real
# deployment this service should almost always sit behind the same
# reverse proxy as Laravel (or not be publicly exposed at all - Laravel is
# the only intended caller) rather than binding 0.0.0.0 on an internet-facing
# host. If it must be reachable only by Laravel, bind HIUSA_AI_HOST=127.0.0.1.

# HIUSA_AI_RELOAD=false
# The dev default (true) restarts the process on every source-file change,
# which is not something a production process manager wants happening
# under it. Set this false for any deployed instance.
