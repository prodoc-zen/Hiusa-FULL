# HIUSA deterministic Python AI service
# Copy this file to ai-service/.env.
#
# This key must exactly match HIUSA_AI_SERVICE_KEY in server/.env.
# Generate a long random value; do not use this placeholder in production.
HIUSA_AI_SERVICE_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_KEY_IN_BOTH_FILES
HIUSA_TASK_POSITION_WEIGHT=0.35
HIUSA_TASK_WORKLOAD_WEIGHT=0.30
HIUSA_TASK_PERFORMANCE_WEIGHT=0.20
HIUSA_TASK_RECENCY_WEIGHT=0.15
HIUSA_TASK_RECENCY_WINDOW_DAYS=14

# Bind to this exact interface. The default keeps the service private to this
# computer because Laravel is its only intended caller.
HIUSA_AI_HOST=127.0.0.1
HIUSA_AI_PORT=8001

# Keep true for local development. Set false on a deployed/production PC.
HIUSA_AI_RELOAD=true

# GROQ_API_KEY does not belong here. Laravel calls Groq; this service only runs
# deterministic OLS, budget-advisory rules, and weighted task delegation.

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# HIUSA_AI_SERVICE_KEY - do not leave this empty in production.
# The service fails CLOSED: every non-/health endpoint returns 401 unless the
# caller supplies X-AI-Service-Key matching this value exactly. Leaving this
# blank does not disable the check - it just means no key can ever match, so
# every request is rejected. To run without a key on a fully trusted local
# machine, set HIUSA_AI_SERVICE_AUTH_DISABLED=true instead (see below).
# Any deployment reachable by more than the operator must set a real long
# random value here and the identical value in server/.env's
# HIUSA_AI_SERVICE_KEY.

# HIUSA_AI_SERVICE_AUTH_DISABLED - local-dev-only opt-out. Set to "true" to
# skip the API key check entirely (every endpoint accepts unauthenticated
# requests). The service logs a warning on startup while this is active.
# Never set this in a deployment reachable by anyone other than the operator.
# HIUSA_AI_SERVICE_AUTH_DISABLED=true

# Set HIUSA_AI_HOST=0.0.0.0 only when another machine must reach this service
# directly on a trusted network. Do not expose it directly to the internet.

# HIUSA_AI_RELOAD=false
# The dev default (true) restarts the process on every source-file change,
# which is not something a production process manager wants happening
# under it. Set this false for any deployed instance.
