# =============================================================================
# HIUSA LARAVEL API
# Copy this file to server/.env, then run: php artisan key:generate
# Never put real passwords or API keys in this tracked example file.
# =============================================================================

APP_NAME=HIUSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE - MYSQL / XAMPP DEFAULT
# Create a database named hiusa_db before running migrations.
# For SQLite instructions, see README.md.
# =============================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hiusa_db
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# FRONTEND / CORS
# Localhost works on the host PC. The optional private-LAN pattern allows Vite
# on ports 5173/5174 from common home-network IP ranges while APP_ENV=local.
# Remove FRONTEND_ORIGIN_PATTERNS or replace it with exact production origins
# before deploying on the public internet.
# =============================================================================

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_ORIGIN_PATTERNS='#^http://(?:10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(?:1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}):(?:5173|5174)$#'

# =============================================================================
# PYTHON AI SERVICE
# HIUSA_AI_SERVICE_KEY must exactly match ai-service/.env.
# Generate a long random value; do not use this placeholder in production.
# Laravel and Python normally run on the same PC, so 127.0.0.1 is correct even
# when students open the frontend through the host PC's LAN address.
# =============================================================================

HIUSA_AI_SERVICE_ENABLED=true
HIUSA_AI_SERVICE_URL=http://127.0.0.1:8001
HIUSA_AI_SERVICE_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_KEY_IN_BOTH_FILES
HIUSA_AI_SERVICE_CONNECT_TIMEOUT=2
HIUSA_AI_SERVICE_TIMEOUT=10
HIUSA_TASK_MAX_ACTIVE_TASKS=5

# =============================================================================
# GROQ RESPONSES API
# Obtain a key from Groq and put it only in server/.env.
# Groq is the language/XAI layer. The Python service performs deterministic
# OLS forecasting, budget rules, and weighted task scoring.
# =============================================================================

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/responses
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

# =============================================================================
# LARAVEL RUNTIME
# Run `php artisan schedule:work` in deployment for reminders/overdue tasks.
# Run `php artisan queue:work` if queued jobs are introduced or enabled.
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL - "log" writes messages to storage/logs instead of sending email.
# Replace these values when configuring a real SMTP provider.
# =============================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hiusa.local"
MAIL_FROM_NAME="${APP_NAME}"

# Optional cloud storage settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
