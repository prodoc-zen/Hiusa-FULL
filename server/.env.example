# =============================================================================
# HIUSA LARAVEL API
# Copy this file to server/.env, then run: php artisan key:generate
# Never put real passwords or API keys in this tracked example file.
# =============================================================================

APP_NAME=HIUSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE - MYSQL / XAMPP DEFAULT
# Create a database named hiusa_db before running migrations.
# For SQLite instructions, see README.md.
# =============================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hiusa_db
DB_USERNAME=root
DB_PASSWORD=

# 3306 is XAMPP MariaDB's own default and is correct on a machine where
# nothing else is listening there. It is NOT universal: on a machine that
# also has a standalone MySQL 8 install, that install commonly claims 3306
# first and XAMPP's MariaDB has to be reconfigured onto another port (3307
# on this project's primary dev machine) with its own credentials. If
# migrations fail to connect, check XAMPP's actual configured port
# (XAMPP Control Panel > MySQL > Config > my.ini) before assuming this
# value is right - do not guess it from this file.

# =============================================================================
# FRONTEND / CORS
# Localhost works on the host PC. The optional private-LAN pattern allows Vite
# on ports 5173/5174 from common home-network IP ranges while APP_ENV=local.
# Remove FRONTEND_ORIGIN_PATTERNS or replace it with exact production origins
# before deploying on the public internet.
# =============================================================================

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_ORIGIN_PATTERNS='#^http://(?:10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(?:1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}):(?:5173|5174)$#'

# =============================================================================
# PYTHON AI SERVICE
# HIUSA_AI_SERVICE_KEY must exactly match ai-service/.env.
# Generate a long random value; do not use this placeholder in production.
# Laravel and Python normally run on the same PC, so 127.0.0.1 is correct even
# when students open the frontend through the host PC's LAN address.
# =============================================================================

HIUSA_AI_SERVICE_ENABLED=true
HIUSA_AI_SERVICE_URL=http://127.0.0.1:8001
HIUSA_AI_SERVICE_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_KEY_IN_BOTH_FILES
HIUSA_AI_SERVICE_CONNECT_TIMEOUT=2
HIUSA_AI_SERVICE_TIMEOUT=10
HIUSA_TASK_MAX_ACTIVE_TASKS=5
HIUSA_TASK_POSITION_WEIGHT=0.40
HIUSA_TASK_WORKLOAD_WEIGHT=0.35
HIUSA_TASK_PERFORMANCE_WEIGHT=0.25

# =============================================================================
# GROQ RESPONSES API
# Obtain a key from Groq and put it only in server/.env.
# Groq is the language/XAI layer. The Python service performs deterministic
# OLS forecasting, budget rules, and weighted task scoring.
# =============================================================================

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/responses
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

# =============================================================================
# LARAVEL RUNTIME
# Run `php artisan schedule:work` in deployment for reminders/overdue tasks.
# A queue worker is REQUIRED, not optional: password-reset mail
# (PasswordResetMail) and approval-request notification fan-out
# (NotifyApproversJob) are both queued jobs. With QUEUE_CONNECTION=database
# (the default below) they land in the `jobs` table and sit there until
# `php artisan queue:work` runs. If nobody runs it, the API call that
# dispatched the job still returns success and the failure is silent - see
# docs/OPERATIONS.md §1 ("A queue worker is also required, not optional").
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=hiusa

# Short, private API response caching. The database cache store works locally
# and in the production Compose stack without an additional service.
API_RESPONSE_CACHE_ENABLED=true
API_RESPONSE_CACHE_TTL=20
API_RESPONSE_CACHE_MAX_BYTES=1048576

# Per-client/per-account limits. Raise these only after checking real traffic.
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PASSWORD_PER_MINUTE=5
RATE_LIMIT_REGISTRATION_PER_MINUTE=5

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL - "log" writes messages to storage/logs instead of sending email.
# Replace these values when configuring a real SMTP provider.
# =============================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hiusa.local"
MAIL_FROM_NAME="${APP_NAME}"

# Optional cloud storage settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# PRODUCTION OVERRIDES
# Everything above this line is the LOCAL development template. This section
# is not a second copy of the file to paste in - it lists every value that
# must change for a real deployment (more than one real user, reachable
# outside this one PC), and why, so the reasoning travels with the operator
# instead of being copied blindly. See docs/DEPLOYMENT.md for the full
# go-live checklist.
# =============================================================================

# APP_ENV=production
# Switches Laravel's error handling, config caching assumptions, and a few
# package defaults (e.g. Sanctum's stateful-domain check) into production
# mode. Leaving it "local" in production also leaves scaffolding like
# `withFaker()` test helpers and verbose framework logging enabled that a
# real deployment does not want.

# APP_DEBUG=false
# THIS IS THE ONE THAT MATTERS MOST. With APP_DEBUG=true, an unhandled
# exception renders Laravel's debug page to the browser: full stack trace,
# the failing SQL query, file paths on the server, and any environment
# values interpolated into that query or view. That is a direct information
# leak to anyone who can trigger a 500 - and on a multi-tenant system like
# this one, "anyone" includes every logged-in student. There is no
# production scenario where APP_DEBUG=true is correct.

# APP_URL=https://your-real-domain.example
# Used to generate absolute URLs (password reset links, asset URLs when not
# using a separate CDN). Must be the real, public HTTPS URL - not
# http://localhost:8000.

# HTTPS assumption
# Nothing in this file turns on TLS by itself - Laravel does not terminate
# HTTPS. A real deployment sits behind a reverse proxy (nginx/Caddy/the
# platform's own load balancer, see docs/DEPLOYMENT.md) that holds the
# certificate and forwards plain HTTP to php-fpm/artisan serve on localhost.
# APP_URL must still be the https:// URL so Laravel's generated links and
# Sanctum's same-site cookie logic agree with what the browser actually sees.

# SESSION_SECURE_COOKIE=true
# Local dev leaves this false because the dev server is plain http://.
# Once the app is actually served over HTTPS (see above), this MUST become
# true - it tells the browser never to send the session cookie over a plain
# HTTP connection, which matters here because Sanctum's SPA mode
# (used for the token cookie flow) rides on the session cookie.

# QUEUE_CONNECTION=database
# Already the default in this file, and that is deliberate: this project's
# `jobs` table exists from the stock Laravel migrations, so the database
# queue driver needs no extra infrastructure (no Redis, no SQS) to handle
# more than one concurrent user. Queued notification fan-out and mail
# sending only actually run once a queue worker is running - see
# docs/OPERATIONS.md for `php artisan queue:work` and what happens if
# nobody starts it (queued jobs pile up in `jobs` and never send).

# CACHE_STORE=database
# Same reasoning as the queue driver: works out of the box for a small
# multi-user deployment with the tables already migrated. Move to `redis`
# only if load actually demands it - do not add Redis pre-emptively for a
# capstone-scale deployment.

# SESSION_DRIVER=database
# Already the default here for the same reason: survives more than one PHP
# worker process without extra infrastructure, unlike the `file` driver.

# MAIL_MAILER=log (dev) -> a real mailer (production)
# MAIL_MAILER=log writes every outgoing email, including password-reset
# links, to storage/logs/laravel.log instead of sending it anywhere. That is
# fine for a local demo where you can just read the log, but in a real
# deployment it means the "Forgot your password" flow silently does nothing
# a user can see - the email never arrives, and the user has no way to know
# a log file exists. Set MAIL_MAILER to smtp (or another real Laravel mail
# driver) and fill in MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD from
# a real mail provider before go-live. This is not optional if account
# recovery is supposed to work for anyone but the person with server access.

# LOG_LEVEL=error (or warning)
# Local dev uses `debug`, which is deliberately noisy. In production, `debug`
# level logging can write request/query detail into storage/logs/laravel.log
# continuously, which both fills disk over time and risks logging sensitive
# values. Raise it to `error` (or `warning` while first stabilizing a new
# deployment) once APP_DEBUG=false is confirmed working.

# FRONTEND_URL / FRONTEND_URLS / FRONTEND_ORIGIN_PATTERNS
# The LAN regex pattern above (10.x/192.168.x/172.16-31.x on ports 5173/5174)
# exists ONLY so a teammate's phone or laptop on the same trusted network can
# reach a dev server. It has no place in production: replace
# FRONTEND_ORIGIN_PATTERNS with nothing (remove the variable) and set
# FRONTEND_URL / FRONTEND_URLS to the exact real frontend origin(s), e.g.
# FRONTEND_URL=https://hiusa.your-real-domain.example
# FRONTEND_URLS=https://hiusa.your-real-domain.example
# An open or LAN-shaped CORS pattern on a public-internet deployment means
# any site can be crafted to ride a logged-in user's session.
