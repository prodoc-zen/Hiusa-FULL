# Docker Compose reads the real values from .env. Run the EC2 setup script to
# generate it securely on the EC2 instance; do not copy these placeholders.
SITE_ADDRESS=YOUR_DOMAIN
MYSQL_DATABASE=hiusa_db
MYSQL_USER=hiusa
MYSQL_PASSWORD=GENERATED_BY_SETUP_SCRIPT
MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP_SCRIPT
