# Install as /etc/hiusa/laravel-native.env (root:www-data, mode 640). Keys only: put the real values on the
# server and never commit them. The hiusa-artisan wrapper and the systemd drop-ins both read this file, so
# keep values free of spaces and quotes.
HIUSA_AI_SERVICE_URL=http://127.0.0.1:8001
HIUSA_AI_SERVICE_KEY=REPLACE_WITH_THE_KEY_THE_AI_SERVICE_USES
